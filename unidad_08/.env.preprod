# .env.example — ESTE archivo SÍ va en Git (sin secretos reales)
# Copia como .env.preprod y rellena los valores reales:
#   cp .env.example .env.preprod

# Entorno
ENV=preprod
DEBUG=False
LOG_LEVEL=INFO

# API
API_PORT=8000
API_WORKERS=1

# MLflow
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT=picos-intensidad-preprod

# Modelo
MODEL_VERSION=latest
RECALL_MIN=0.70

# Seguridad (rellenar con valores reales en .env.preprod)
SECRET_KEY=cambia-esto-en-preprod